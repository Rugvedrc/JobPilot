# Optional. Each user normally adds their own keys in the app (Settings), stored encrypted.
# Only the first (owner) account and the command-line tools fall back to this file.
# Copy to .env and fill in.

APIFY_API_KEY=          # job board scraping — https://console.apify.com/account/integrations
GROQ_API_KEY=           # AI checks and writing — https://console.groq.com/keys
SERPER_API_KEY=         # optional: Google results for contact search — https://serper.dev
GMAIL_APP_PASSWORD=     # optional: email outreach — https://myaccount.google.com/apppasswords
JF_TITLE_SCREEN=1       # optional: 0 turns off the AI job-title pre-screen
